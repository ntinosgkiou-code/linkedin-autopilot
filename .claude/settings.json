{
  "enabledMcpjsonServers": ["linkedin"],
  "permissions": {
    "allow": [
      "mcp__linkedin",
      "Bash(uv run tools/guard.py:*)",
      "Bash(uv run tools/linkedin_post.py publish:*)",
      "Bash(uv run tools/linkedin_post.py status)",
      "Read",
      "Edit(data/**)",
      "Edit(config.yaml)"
    ],
    "deny": [
      "Read(data/.secrets/**)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "MCP_TIMEOUT": "180000",
    "MCP_TOOL_TIMEOUT": "300000"
  }
}
